{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/templates/**"],
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "experimentalSortImports": {
    "groups": [
      ["internal", "internal-type"],
      ["builtin"],
      ["external", "external-type"],
      ["parent", "parent-type"],
      ["sibling", "sibling-type"],
      ["index", "index-type"]
    ],
    "internalPattern": ["@humaans/", "@athena/"],
    "order": "asc",
    "ignoreCase": false,
    "newlinesBetween": false
  }
}
